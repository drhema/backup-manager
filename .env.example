# =============================================================================
# Backup Manager — env vars (set these in Portainer when deploying the stack)
# =============================================================================

# REQUIRED — master key for encrypting stored secrets (pg passwords, S3 keys)
# Generate once with: openssl rand -hex 32
# If you lose this key, all stored DB and S3 credentials become unrecoverable.
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# REQUIRED — image tag pulled via Portainer stack (set when deploying)
BACKUP_MANAGER_IMAGE=ghcr.io/your-org/backup-manager:latest

# OPTIONAL — listen port inside the container (default 8085)
PORT=8085

# OPTIONAL — pre-seed a default S3 destination at first boot (Cloudflare R2 example)
# If set, the app creates a Destination row with these values on first run.
DEFAULT_S3_NAME=primary-r2
DEFAULT_S3_TYPE=s3
DEFAULT_S3_ENDPOINT=https://77b837fe63915a67beb4a054abad0ee2.r2.cloudflarestorage.com
DEFAULT_S3_REGION=auto
DEFAULT_S3_BUCKET=your-bucket-name
DEFAULT_S3_PATH_PREFIX=postgres/
DEFAULT_S3_ACCESS_KEY=your-r2-access-key
DEFAULT_S3_SECRET_KEY=your-r2-secret-key

# OPTIONAL — Portainer API for future "auto-discover Postgres containers" feature
# Generate from Portainer: User settings -> API tokens -> Add new token
PORTAINER_URL=https://portainer:9000
PORTAINER_API_KEY=

# OPTIONAL — Cloudflare Access JWT verification (recommended for production)
# Find values at: CF Zero Trust -> Settings -> Custom Pages -> Application Audience tag
CF_ACCESS_TEAM_DOMAIN=                       # e.g. your-team.cloudflareaccess.com
CF_ACCESS_AUD_TAG=                           # the Application Audience (AUD) Tag from the Access app
# If both above are set, the app will VERIFY the Cf-Access-Jwt-Assertion header on
# every request. If unset, the app trusts that CF Access is in front (less safe
# in case of accidental tunnel misconfiguration).

# OPTIONAL — schedule loop tick interval (seconds). Default 60 means cron is
# evaluated once per minute. Don't lower below 30s.
SCHEDULER_TICK_SECONDS=60

# OPTIONAL — default retention policy applied to new schedules (override per schedule)
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=6
