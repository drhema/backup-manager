{
  "name": "backup-manager",
  "version": "0.1.0",
  "description": "Web UI for Postgres backup/restore to S3/R2/B2, designed for the Portainer hosting platform",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot run src/index.tsx",
    "start": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/lib-storage": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.10",
    "typescript": "^5.5.4"
  }
}
